{
  "name": "fockytv",
  "version": "0.5.2",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "tv.focky.client",
    "files": [
      "electron/**",
      "ui/**",
      "build/icon.png",
      "config.json",
      "package.json"
    ],
    "extraFiles": [
      "config.json"
    ],
    "asarUnpack": [
      "electron/audio-helper/audio-helper.exe"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FelipeMayerDev",
        "repo": "fockytv"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
