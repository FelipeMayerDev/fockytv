+// hostIsSending: algum pacote de mídia nos últimos segundos = publicador de
+// verdade no ar (não é fantasma de crash). O Bitrate não serve: a janela de
+// 1s congela com o último valor depois que o host morre.
+func hostIsSending(host *whip.WHIPSession) bool {
+	const healthyWithin = 10 * time.Second
+	cutoff := time.Now().Add(-healthyWithin)
+
+	host.TracksLock.RLock()
+	defer host.TracksLock.RUnlock()
+	for _, t := range host.VideoTracks {
+		if v, ok := t.LastReceived.Load().(time.Time); ok && v.After(cutoff) {
+			return true
+		}
+	}
+	for _, t := range host.AudioTracks {
+		if v, ok := t.LastReceived.Load().(time.Time); ok && v.After(cutoff) {
+			return true
+		}
+	}
+	return false
+}
